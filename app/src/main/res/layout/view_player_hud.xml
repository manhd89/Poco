<?xml version="1.0" encoding="utf-8"?>
<!--
    Lớp điều khiển (HUD) nằm trên PlayerView của Media3.
    Thiết kế Cinema Obsidian Glass: phân tầng rõ ràng, không đè chéo trên mọi tỉ lệ.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_hud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/hud_top_gradient"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top_gradient"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/hud_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_gradient"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/hud_top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/hud_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_player_icon_button"
            android:contentDescription="@string/player_minimize"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_expand_more"
            android:tint="@color/player_on_scrim" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hud_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/player_on_scrim"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Tên video đang phát" />

            <TextView
                android:id="@+id/hud_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/player_on_scrim_secondary"
                android:textSize="12sp"
                tools:text="Tên kênh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hud_top_actions"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_player_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/hud_autoplay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_autoplay"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_autorenew"
                android:tint="@color/player_on_scrim" />

            <ImageButton
                android:id="@+id/hud_pip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_pip"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_picture_in_picture"
                android:tint="@color/player_on_scrim" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hud_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/hud_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_player_icon_button"
            android:contentDescription="@string/player_previous"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/player_on_scrim" />

        <ImageButton
            android:id="@+id/hud_play_pause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_player_center_button"
            android:contentDescription="@string/player_play_pause"
            android:padding="17dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/player_on_scrim" />

        <ImageButton
            android:id="@+id/hud_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/bg_player_icon_button"
            android:contentDescription="@string/player_next"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/player_on_scrim" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/hud_buffering"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_on_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hud_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/hud_seek_container"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:clipChildren="false">

            <com.luxysiv.puretube.ui.player.PlayerSeekBar
                android:id="@+id/hud_seek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="1000"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progress="0"
                android:progressDrawable="@drawable/progress_player_seek"
                android:splitTrack="false"
                android:thumb="@drawable/thumb_player_seek" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/hud_button_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hud_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/player_time_zero"
                    android:textColor="@color/player_on_scrim"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hud_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/player_time_zero_total"
                    android:textColor="@color/player_on_scrim_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hud_time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="@string/player_time_zero_remaining"
                    android:textColor="@color/player_on_scrim_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hud_live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_player_live_badge"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/player_live"
                    android:textColor="@color/player_on_scrim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/hud_mix"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_mix"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_playlist_play"
                android:tint="@color/player_on_scrim"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/hud_captions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_captions"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_subtitles"
                android:tint="@color/player_on_scrim"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/hud_lock"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_lock_controls"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lock"
                android:tint="@color/player_on_scrim"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/hud_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_settings_desc"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                android:tint="@color/player_on_scrim" />

            <ImageButton
                android:id="@+id/hud_fullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="@string/player_fullscreen"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_fullscreen"
                android:tint="@color/player_on_scrim" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hud_seek_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_player_seek_bubble"
        android:fontFamily="@font/plus_jakarta_sans"
        android:fontFeatureSettings="tnum"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="@color/player_on_scrim"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="12:34" />

    <TextView
        android:id="@+id/hud_sponsor_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_player_sponsor"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="168dp"
        android:minHeight="36dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/player_skip_segment"
        android:textColor="#FF10131A"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/hud_unlock"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_player_icon_button"
        android:contentDescription="@string/player_unlock_controls"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lock_open"
        android:tint="@color/player_on_scrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/hud_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BA080A0F"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hud_error_card"
            android:layout_width="308dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_player_error"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/hud_error_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_cloud_off"
                android:tint="@color/player_on_scrim" />

            <TextView
                android:id="@+id/hud_error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/player_error_title"
                android:textColor="@color/player_on_scrim"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_error_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/player_on_scrim_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hud_error_retry"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/action_retry"
                android:textAllCaps="false"
                app:cornerRadius="100dp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/hud_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:clipChildren="false"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hud_flash_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_player_flash"
            android:gravity="center"
            android:minWidth="56dp"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="9dp">

            <ImageView
                android:id="@+id/hud_flash_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/ic_forward_10"
                android:tint="@color/player_on_scrim" />

            <TextView
                android:id="@+id/hud_flash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/player_on_scrim"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="85%" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
