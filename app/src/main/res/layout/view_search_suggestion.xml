<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="1dp"
    android:paddingEnd="4dp"
    android:paddingBottom="1dp">

    <ImageView
        android:id="@+id/search_suggestion_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_search"
        android:tint="@color/pure_on_surface_variant" />

    <TextView
        android:id="@+id/search_suggestion_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/pure_on_surface"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/search_suggestion_trailing"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_remove_history"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        android:tint="@color/pure_on_surface_variant"
        android:visibility="gone" />
</LinearLayout>
