<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ProgressBar
        android:id="@+id/load_more_progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="@color/pure_primary" />

    <TextView
        android:id="@+id/load_more_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/load_more_loading"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/load_more_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/action_retry"
        android:textColor="@color/pure_tertiary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
