<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_offline_banner"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_cloud_off"
        android:tint="@color/pure_on_surface_variant" />

    <TextView
        android:id="@+id/home_offline_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="@string/home_offline"
        android:textColor="@color/pure_on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/home_offline_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/action_retry"
        android:textColor="@color/pure_tertiary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
