<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="21dp"
        android:background="@drawable/bg_brand_logo">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_play_arrow"
            android:tint="@android:color/white" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif"
        android:text="@string/brand_name"
        android:textColor="@color/pure_on_surface"
        android:textSize="21sp"
        android:textStyle="bold"
        android:letterSpacing="-0.04" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:paddingTop="2dp"
        android:text="@string/home_region"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="11sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/home_cast"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home_cast"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_cast"
        android:tint="@color/pure_on_surface" />
    <ImageButton
        android:id="@+id/home_notifications"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home_notifications"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notifications"
        android:tint="@color/pure_on_surface" />
    <ImageButton
        android:id="@+id/home_search"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home_search"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_search"
        android:tint="@color/pure_on_surface" />
    <TextView
        android:id="@+id/home_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_avatar_red"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="@string/home_avatar_letter"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
