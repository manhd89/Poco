<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="48dp"
    android:paddingEnd="16dp"
    android:paddingBottom="48dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_circle_tonal">

        <ImageView
            android:id="@+id/home_empty_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_cloud_off"
            android:tint="@color/pure_on_surface_variant" />
    </FrameLayout>

    <TextView
        android:id="@+id/home_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:textColor="@color/pure_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxWidth="360dp"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_empty_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAllCaps="false"
        android:textColor="@color/pure_surface"
        android:textSize="14sp"
        app:backgroundTint="@color/pure_on_surface"
        app:cornerRadius="100dp"
        app:elevation="0dp" />
</LinearLayout>
