<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="24dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_hero_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_badge_tonal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_cloud_off"
            android:tint="@color/pure_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/search_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:text="@string/search_error_title"
        android:textColor="@color/pure_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/search_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxWidth="360dp"
        android:text="@string/search_error_message"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/search_error_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_primary_pill"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/action_retry"
        android:textColor="@color/pure_on_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
