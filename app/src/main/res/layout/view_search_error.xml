<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="48dp"
    android:paddingEnd="32dp"
    android:paddingBottom="48dp">

    <TextView
        android:id="@+id/search_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_error_title"
        android:textColor="@color/pure_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/search_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/search_error_message"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/search_error_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:text="@string/action_retry"
        android:textColor="@color/pure_tertiary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
