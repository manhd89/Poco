<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="56dp"
    android:paddingEnd="24dp"
    android:paddingBottom="56dp">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_circle_tonal">

        <ImageView
            android:id="@+id/library_empty_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_history"
            android:tint="@color/pure_on_surface_variant" />
    </FrameLayout>

    <TextView
        android:id="@+id/library_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:textColor="@color/pure_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/library_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxWidth="340dp"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="14sp" />
</LinearLayout>
