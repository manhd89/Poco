<?xml version="1.0" encoding="utf-8"?>
<!--
    Mini player native. Khung video chỉ là container rỗng; PlayerSurfaceHost
    di chuyển surface Media3 dùng chung vào/ra khỏi đây nên không có texture
    thứ hai và không bị đen khi Activity phía sau nhả surface.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/pure_mini_player_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="@dimen/mini_player_elevation"
    app:cardPreventCornerOverlap="false"
    app:strokeColor="@color/pure_mini_player_stroke"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mini_player_row"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="47dp"
                android:background="@drawable/bg_video_thumb"
                android:clipToOutline="true">

                <!-- Surface Media3 dùng chung được host di chuyển vào đây. -->
                <FrameLayout
                    android:id="@+id/mini_player_video_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />

                <ProgressBar
                    android:id="@+id/mini_player_buffering"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mini_player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/pure_on_surface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/mini_player_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pure_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/mini_player_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_pause"
                android:padding="8dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/pure_on_surface" />

            <ImageButton
                android:id="@+id/mini_player_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_next"
                android:padding="8dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/pure_on_surface" />

            <ImageButton
                android:id="@+id/mini_player_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_close"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="@color/pure_on_surface" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/pure_progress_track">

            <View
                android:id="@+id/mini_player_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/pure_progress_fill" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
