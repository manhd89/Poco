<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="72dp"
    android:paddingEnd="32dp"
    android:paddingBottom="72dp">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_circle_tonal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_video_library"
            android:tint="@color/pure_on_surface_variant" />
    </FrameLayout>

    <TextView
        android:id="@+id/subscriptions_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:text="@string/subscriptions_empty_title"
        android:textColor="@color/pure_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subscriptions_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxWidth="360dp"
        android:text="@string/subscriptions_empty_message"
        android:textColor="@color/pure_on_surface_variant"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/subscriptions_explore"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/subscriptions_explore"
        android:textAllCaps="false"
        android:textColor="@color/pure_surface"
        android:textSize="14sp"
        app:backgroundTint="@color/pure_on_surface"
        app:cornerRadius="100dp"
        app:elevation="0dp" />
</LinearLayout>
