<?xml version="1.0" encoding="utf-8"?>
<!-- Rail điều hướng phẳng Android 16 cho màn hình medium (600–839dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/rail_brand"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_brand_logo">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_brand_play" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rail_nav_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/rail_nav_home_pill"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_pill">

            <ImageView
                android:id="@+id/rail_nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                android:tint="@color/pure_nav_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/rail_nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:text="@string/nav_home"
            android:textColor="@color/pure_nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rail_nav_subscriptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/rail_nav_subscriptions_pill"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_pill">

            <ImageView
                android:id="@+id/rail_nav_subscriptions_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_subscriptions"
                android:tint="@color/pure_nav_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/rail_nav_subscriptions_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:text="@string/nav_subscriptions"
            android:textColor="@color/pure_nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rail_nav_library"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/rail_nav_library_pill"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_pill">

            <ImageView
                android:id="@+id/rail_nav_library_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_account_circle"
                android:tint="@color/pure_nav_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/rail_nav_library_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:text="@string/nav_library"
            android:textColor="@color/pure_nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/rail_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/rail_settings_pill"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_pill">

            <ImageView
                android:id="@+id/rail_settings_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="@color/pure_nav_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/rail_settings_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:text="@string/nav_settings"
            android:textColor="@color/pure_nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
