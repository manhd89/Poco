<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_description_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/player_description_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:textColor="@color/pure_on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/player_description_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/player_see_more"
        android:textColor="@color/pure_on_surface"
        android:textSize="14sp" />
</LinearLayout>
