<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.luxysiv.puretube.ui.views.AspectRatioFrameLayout
        android:id="@+id/playlist_thumbnail_container"
        android:layout_width="128dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_video_thumb"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/playlist_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_video_thumb"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:id="@+id/playlist_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_duration"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_playlist_play"
                android:tint="@android:color/white" />
            <TextView
                android:id="@+id/playlist_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.luxysiv.puretube.ui.views.AspectRatioFrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playlist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/pure_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/playlist_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pure_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/playlist_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pure_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>
</merge>
