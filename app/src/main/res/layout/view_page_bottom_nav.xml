<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh điều hướng dưới cùng phẳng chuẩn Material 3 Expressive cho màn hình compact. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pure_surface"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pure_outline_variant" />

    <LinearLayout
        android:id="@+id/bottom_nav_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/bottom_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bottom_nav_home_pill"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_pill">

                <ImageView
                    android:id="@+id/bottom_nav_home_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    android:tint="@color/pure_nav_unselected" />
            </FrameLayout>

            <TextView
                android:id="@+id/bottom_nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_home"
                android:textColor="@color/pure_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_nav_subscriptions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bottom_nav_subscriptions_pill"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_pill">

                <ImageView
                    android:id="@+id/bottom_nav_subscriptions_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_subscriptions"
                    android:tint="@color/pure_nav_unselected" />
            </FrameLayout>

            <TextView
                android:id="@+id/bottom_nav_subscriptions_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_subscriptions"
                android:textColor="@color/pure_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_nav_library"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bottom_nav_library_pill"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_pill">

                <ImageView
                    android:id="@+id/bottom_nav_library_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_account_circle"
                    android:tint="@color/pure_nav_unselected" />
            </FrameLayout>

            <TextView
                android:id="@+id/bottom_nav_library_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_library"
                android:textColor="@color/pure_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
