<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.luxysiv.puretube.ui.views.ChannelAvatarView
        android:id="@+id/comment_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/comment_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/pure_on_surface"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/comment_verified"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@string/player_comment_verified"
                android:src="@drawable/ic_verified"
                android:tint="@color/pure_on_surface_variant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/comment_owner_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/player_comment_author_badge"
                android:textColor="@color/pure_on_surface_variant"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/comment_hearted"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/player_comment_hearted"
                android:src="@drawable/ic_favorite"
                android:tint="@color/pure_tertiary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/comment_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:textColor="@color/pure_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/comment_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoLink="web"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pure_on_surface"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/player_like"
                android:src="@drawable/ic_thumb_up"
                android:tint="@color/pure_on_surface_variant" />

            <TextView
                android:id="@+id/comment_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/pure_on_surface_variant"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/player_comment_dislike"
                android:src="@drawable/ic_thumb_down"
                android:tint="@color/pure_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
