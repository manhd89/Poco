<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/pure_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="-0.02"
            android:text="@string/subscriptions_title"
            android:textColor="@color/pure_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/subscriptions_manage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_tonal_48"
            android:contentDescription="@string/subscriptions_manage"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/pure_on_surface" />

        <ImageButton
            android:id="@+id/subscriptions_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_circle_tonal_48"
            android:contentDescription="@string/home_search"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            android:tint="@color/pure_on_surface" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pure_outline_variant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subscriptions_channels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/subscriptions_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subscriptions_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="32dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            android:id="@+id/subscriptions_empty"
            layout="@layout/view_subscriptions_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
