<?xml version="1.0" encoding="utf-8"?>
<!--
    Cửa sổ duy nhất của app: trang nội dung + mini player nằm trong [page_root],
    còn trình phát là một overlay phủ lên TRONG CÙNG cửa sổ. Nhờ vậy khi thu nhỏ
    trang xem, trang bên dưới là chính các View thật (không phải ảnh chụp) nên
    không bị lệch/giật ở thời điểm bàn giao.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_background">

    <LinearLayout
        android:id="@+id/page_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pure_background"
        android:orientation="horizontal">

        <!-- Rail (medium) hoặc drawer (expanded) bên trái. -->
        <FrameLayout
            android:id="@+id/page_side_nav"
            android:layout_width="@dimen/page_rail_width"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include
                android:id="@+id/page_rail"
                layout="@layout/view_page_rail"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_drawer"
                layout="@layout/view_page_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!--
            Dùng match_parent + weight (không dùng 0dp) để LinearLayout không đo
            lượt đầu với kích thước UNSPECIFIED; nội dung trang cần biên rõ ràng
            để các thành phần cuộn ngang/dọc hoạt động đúng.
        -->
        <LinearLayout
            android:id="@+id/page_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nội dung trang. Activity sẽ thêm padding system bar vào view này. -->
            <FrameLayout
                android:id="@+id/page_content_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.luxysiv.puretube.ui.scaffold.MiniPlayerView
                android:id="@+id/page_mini_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/page_bottom_nav"
                layout="@layout/view_page_bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Trình phát overlay: cùng cửa sổ với trang nội dung nên thu nhỏ chỉ là
        animate view này về khung mini player; trang bên dưới không đổi.
    -->
    <com.luxysiv.puretube.ui.player.PlayerNativeView
        android:id="@+id/page_player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
